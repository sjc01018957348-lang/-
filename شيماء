<style>
*{box-sizing:border-box;margin:0;padding:0;scroll-behavior:smooth}
body{font-family:Tahoma,Arial,sans-serif;background:linear-gradient(rgba(7,9,15,.92),rgba(7,9,15,.97)),radial-gradient(circle at top,#29344d,#07090f 65%);color:#fff;line-height:1.8}
nav{position:fixed;top:0;width:100%;z-index:10;background:rgba(8,10,16,.95);border-bottom:1px solid #c6a451}
.nav{max-width:1150px;margin:auto;padding:14px 20px;display:flex;justify-content:space-between;align-items:center}
.logo{color:#d9b65c;font-weight:bold;font-size:21px}.links{display:flex;gap:22px;list-style:none}.links a{color:#fff;text-decoration:none}.links a:hover{color:#d9b65c}
.hero{min-height:100vh;display:grid;place-items:center;text-align:center;padding:120px 20px 60px}
.hero .icon{font-size:80px;color:#d9b65c}.hero h1{font-size:clamp(36px,6vw,68px);color:#d9b65c}.hero h2{font-size:25px;margin:8px 0 15px}.hero p{max-width:760px;margin:auto;color:#ddd;font-size:18px}
.btn{display:inline-block;padding:12px 26px;border-radius:28px;text-decoration:none;font-weight:bold;margin:18px 6px 0;transition:.25s}.gold{background:#d9b65c;color:#111}.outline{border:1px solid #d9b65c;color:#d9b65c}.btn:hover{transform:translateY(-3px)}
section{padding:85px 20px}.dark{background:#0d111b}.container{max-width:1150px;margin:auto}.title{text-align:center;margin-bottom:42px}.title h2{font-size:34px;color:#d9b65c}.title p{color:#aaa}
.about{display:grid;grid-template-columns:1fr 1.5fr;gap:35px;align-items:center}.profile{min-height:330px;border:1px solid #b99647;border-radius:20px;background:linear-gradient(145deg,#181e2b,#0a0d14);display:grid;place-items:center;text-align:center;padding:25px}.profile .scale{font-size:100px;color:#d9b65c}.about h3{color:#d9b65c;font-size:27px;margin-bottom:12px}.about p{color:#ddd;font-size:17px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{background:linear-gradient(145deg,#171c29,#0c0f17);border:1px solid rgba(217,182,92,.35);border-radius:18px;padding:27px;transition:.25s}.card:hover{transform:translateY(-6px);border-color:#d9b65c}.card .ico{font-size:40px}.card h3{color:#d9b65c;margin:7px 0}.card p{color:#bbb}.card button{margin-top:16px;width:100%;padding:11px;border:0;border-radius:8px;background:#d9b65c;color:#111;font-weight:bold;cursor:pointer}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}.box{background:#111620;padding:28px;border-radius:18px;border:1px solid rgba(217,182,92,.3)}.box h3{color:#d9b65c;margin-bottom:16px}.line{margin:13px 0;color:#ddd}.line b{color:#d9b65c}
input,textarea,select{width:100%;margin-bottom:14px;padding:13px;border-radius:8px;border:1px solid #384052;background:#080b11;color:#fff}textarea{min-height:120px;resize:vertical}form button{width:100%;padding:13px;border:0;border-radius:8px;background:#d9b65c;font-weight:bold;cursor:pointer}
footer{text-align:center;padding:28px;background:#06080d;color:#aaa;border-top:1px solid #272c37}footer span{color:#d9b65c}
.modal{display:none;position:fixed;inset:0;background:#000b;z-index:20;place-items:center;padding:20px}.modalbox{max-width:600px;width:100%;background:#121722;border:1px solid #d9b65c;border-radius:18px;padding:32px;position:relative}.close{position:absolute;left:18px;top:8px;font-size:30px;color:#d9b65c;cursor:pointer}
@media(max-width:800px){.links{display:none}.about,.contact-grid{grid-template-columns:1fr}.cards{grid-template-columns:1fr 1fr}}@media(max-width:520px){.cards{grid-template-columns:1fr}.hero h1{font-size:39px}}
</style>
</head>
<body>
<nav><div class="nav"><div class="logo">⚖️ مكتب المحاماة</div><ul class="links"><li><a href="#home">الرئيسية</a></li><li><a href="#about">عن المحامية</a></li><li><a href="#services">الخدمات</a></li><li><a href="#courses">الكورسات</a></li><li><a href="#contact">التواصل</a></li></ul></div></nav>

<section class="hero" id="home"><div><div class="icon">⚖️</div><h1>شيماء عبد العظيم صابر</h1><h2>محامية ومستشارة قانونية</h2><p>موقع قانوني تعريفي وتوعوي يقدم معلومات مبسطة حول عدد من الموضوعات القانونية وخدمات التواصل والاستشارة.</p><a class="btn gold" href="tel:01012056210">📞 01012056210</a><a class="btn outline" href="#courses">📚 الكورسات</a></div></section>

<section class="dark" id="about"><div class="container"><div class="title"><h2>عن المحامية</h2><p>نبذة تعريفية</p></div><div class="about"><div class="profile"><div><div class="scale">⚖️</div><h3>شيماء عبد العظيم صابر</h3><p>محامية ومستشارة قانونية</p></div></div><div><h3>خبرة واهتمام بالمجال القانوني</h3><p>المحامية شيماء عبد العظيم صابر تهتم بالمجال القانوني وتسعى إلى تقديم المعلومات والاستشارات بصورة واضحة ومنظمة. يهتم الموقع بالتوعية القانونية وتبسيط بعض الموضوعات التي تهم الأفراد والأسرة، مع التركيز على فهم المصطلحات والإجراءات بصورة سهلة، واحترام خصوصية العملاء وسرية المعلومات. كما يضم الموقع محتوى تعليميًا حول قضايا الأسرة والطلاق والنفقة والحضانة وغيرها من الموضوعات القانونية، بهدف مساعدة المهتمين على تكوين فهم أولي للمفاهيم القانونية قبل طلب المشورة المتخصصة.</p></div></div></div></section>

<section id="services"><div class="container"><div class="title"><h2>الخدمات القانونية</h2><p>مجالات متنوعة</p></div><div class="cards">
<div class="card"><div class="ico">💍</div><h3>قضايا الأسرة</h3><p>معلومات عامة وتوعية حول مسائل الأسرة والإجراءات المرتبطة بها.</p></div>
<div class="card"><div class="ico">📄</div><h3>الاستشارات القانونية</h3><p>شرح مبسط للمفاهيم والإجراءات القانونية حسب طبيعة الاستفسار.</p></div>
<div class="card"><div class="ico">🏠</div><h3>القضايا المدنية</h3><p>محتوى توعوي حول بعض المسائل والحقوق والالتزامات المدنية.</p></div>
<div class="card"><div class="ico">👨‍👩‍👧</div><h3>مشكلات الأسرة</h3><p>توعية قانونية حول بعض المشكلات الأسرية وسبل فهمها.</p></div>
<div class="card"><div class="ico">💰</div><h3>النفقة</h3><p>معلومات عامة حول مفهوم النفقة وبعض الإجراءات المتعلقة بها.</p></div>
<div class="card"><div class="ico">🔐</div><h3>الخصوصية</h3><p>الاهتمام بسرية المعلومات أثناء التواصل والاستشارة.</p></div>
</div></div></section>

<section class="dark" id="courses"><div class="container"><div class="title"><h2>الكورسات القانونية</h2><p>تعلم وفهم أساسيات الموضوعات القانونية</p></div><div class="cards" id="courseCards"></div></div></section>

<section id="contact"><div class="container"><div class="title"><h2>تواصل معنا</h2><p>للاستفسار وحجز موعد</p></div><div class="contact-grid"><div class="box"><h3>بيانات التواصل</h3><div class="line">📞 <b>الهاتف:</b> <a href="tel:01012056210" style="color:white">01012056210</a></div><div class="line">⚖️ <b>الاسم:</b> شيماء عبد العظيم صابر</div><div class="line">💼 <b>المهنة:</b> محامية ومستشارة قانونية</div><a class="btn gold" href="tel:01012056210">اتصل الآن</a></div><form class="box" id="form"><input required placeholder="الاسم بالكامل"><input required type="tel" placeholder="رقم الهاتف"><select><option>استشارة قانونية</option><option>كورس الطلاق</option><option>مشاكل الأسرة</option><option>النفقة</option><option>الحضانة</option><option>موضوع آخر</option></select><textarea required placeholder="اكتب رسالتك"></textarea><button>إرسال الطلب</button></form></div></div></section>

<footer>© <span id="year"></span> جميع الحقوق محفوظة — <span>المحامية شيماء عبد العظيم صابر</span></footer>

<div class="modal" id="modal"><div class="modalbox"><span class="close" onclick="closeModal()">×</span><h2 id="mt" style="color:#d9b65c"></h2><p id="mp"></p><a class="btn gold" href="tel:01012056210">📞 للاستفسار</a></div></div>

<script>
const courses=[
["💔","كورس الطلاق","شرح مبسط للمفاهيم العامة والإجراءات المرتبطة بالطلاق.","الطلاق"],
["👨‍👩‍👧","كورس مشاكل الأسرة","التعرف على بعض المشكلات الأسرية من منظور قانوني وتوعوي.","مشاكل الأسرة"],
["💰","كورس النفقة","مقدمة مبسطة حول مفهوم النفقة وبعض الجوانب القانونية المرتبطة بها.","النفقة"],
["👶","كورس الحضانة","شرح عام للمفاهيم الأساسية المتعلقة بالحضانة والرعاية.","الحضانة"],
["🏠","كورس السكن","معلومات عامة حول بعض المسائل القانونية المتعلقة بالسكن.","السكن"],
["📚","أساسيات القانون","مقدمة للمبتدئين في المصطلحات والمفاهيم القانونية الأساسية.","أساسيات القانون"]
];
const cards=document.getElementById("courseCards");
courses.forEach((c,i)=>cards.innerHTML+=`<div class="card"><div class="ico">${c[0]}</div><h3>${c[1]}</h3><p>${c[2]}</p><button onclick="openModal('${c[3]}','${c[2]}')">تفاصيل الكورس</button></div>`);
function openModal(t,p){document.getElementById("mt").textContent="كورس "+t;document.getElementById("mp").textContent=p;document.getElementById("modal").style.display="grid"}
function closeModal(){document.getElementById("modal").style.display="none"}
document.getElementById("form").addEventListener("submit",e=>{e.preventDefault();alert("تم تسجيل طلبك بنجاح، شكرًا لتواصلك.");e.target.reset()});
document.getElementById("year").textContent=new Date().getFullYear();
</script>
</body>
</html>
